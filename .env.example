# API Base URL
VITE_API_BASE_URL=http://localhost:3000

# Request Signing Configuration
# UYARI: VITE_ ile başlayan değişkenler frontend bundle'a gömülür; dağıtılan uygulamada görünebilir.
# Bu yüzden client-side imzalama gerçek güvenlik sağlamaz. Gizli işlemler için backend veya Electron main process kullanın.
# İmzalama için gizli anahtar (en az 32 karakter, rastgele oluşturulmalı)
VITE_SIGNING_SECRET=your-32-char-secret-key-here-change-me

# İmzalamayı aktifleştir/deaktifleştir (true/false)
VITE_SIGNING_ENABLED=true
