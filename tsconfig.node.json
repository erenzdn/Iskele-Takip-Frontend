{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "ES2020",
    "outDir": "./dist-electron",
    "rootDir": "./electron",
    "esModuleInterop": true
  },
  "include": ["electron/main.ts"],
  "exclude": ["electron/preload.ts"]
}
