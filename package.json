{
  "name": "iskele-takip-electron",
  "version": "1.0.0",
  "description": "İskeleTakip Desktop - Electron + React + TypeScript",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
  "dev": "npm run electron:dev",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"tsc -p tsconfig.node.json --watch\" \"wait-on http://localhost:5173 && powershell -Command Copy-Item electron\\preload.cjs dist-electron\\preload.cjs -Force -ErrorAction SilentlyContinue; electron dist-electron/main.js\"",
    "electron:build": "npm run build:electron && electron-builder",
    "electron:pack": "npm run build:electron && electron-builder --dir"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "iskele-takip"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.17.1",
    "@tiptap/extension-table": "^3.17.1",
    "@tiptap/extension-table-cell": "^3.17.1",
    "@tiptap/extension-table-header": "^3.17.1",
    "@tiptap/extension-table-row": "^3.17.1",
    "@tiptap/extension-text-align": "^3.17.1",
    "@tiptap/extension-underline": "^3.17.1",
    "@tiptap/react": "^3.17.1",
    "@tiptap/starter-kit": "^3.17.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.1",
    "tiptap-extension-resize-image": "^1.3.2",
    "zustand": "^4.4.7"
  }
}
