{
  "name": "iskele-takip-electron",
  "version": "2.0.1",
  "description": "İskeleTakip Desktop - Electron + React + TypeScript",
  "appId": "com.iskeletakip.app",
  "main": "dist-electron/main.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/erenzdn/Iskele-Takip-Frontend.git"
  },
  "scripts": {
    "dev": "npm run electron:dev",
    "build": "tsc && vite build",
    "test": "vitest run",
    "build:electron": "tsc -p tsconfig.electron.json && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"tsc -p tsconfig.node.json --watch\" \"wait-on http://localhost:5175 && electron dist-electron/main.js\"",
    "electron:build": "npm run build:electron && electron-builder --config electron-builder.config.js",
    "electron:pack": "npm run build:electron && electron-builder --config electron-builder.config.js --dir",
    "publish": "npm run release:github",
    "release:build": "npm run build:electron && electron-builder --config electron-builder.config.js --win --publish never",
    "release:github": "node scripts/publish-github.mjs",
    "release": "npm version patch && npm run release:build && npm run release:github"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "iskele-takip"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vitest": "^4.1.5",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tiptap/extension-image": "^3.17.1",
    "@tiptap/extension-table": "^3.17.1",
    "@tiptap/extension-table-cell": "^3.17.1",
    "@tiptap/extension-table-header": "^3.17.1",
    "@tiptap/extension-table-row": "^3.17.1",
    "@tiptap/extension-text-align": "^3.17.1",
    "@tiptap/extension-underline": "^3.17.1",
    "@tiptap/react": "^3.17.1",
    "@tiptap/starter-kit": "^3.17.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "pdfjs-dist": "^3.11.174",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-pdf": "^7.7.1",
    "react-router-dom": "^6.21.1",
    "recharts": "^3.7.0",
    "tiptap-extension-resize-image": "^1.3.2",
    "zustand": "^4.4.7"
  },
  "overrides": {
    "axios": "1.13.2",
    "security-note": "Axios hacklenmesi nedeniyle 1.13.2 sürümüne sabitlendi."
  }
}
